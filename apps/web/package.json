{
  "name": "@avot/web",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:railway": "prisma migrate deploy && next start",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "create-admin": "dotenv -e .env.local -- tsx scripts/create-admin.ts",
    "seed:perf": "dotenv -e .env.local -- tsx scripts/seed-performance.ts",
    "storage:upload": "dotenv -e .env.local -- tsx scripts/storage-upload.ts",
    "migration:report": "dotenv -e .env.local -- tsx scripts/migration-report.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@avot/shared": "*",
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/lib-storage": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "6.19.3",
    "@zxing/library": "^0.21.3",
    "archiver": "^7.0.1",
    "lucide-react": "^0.544.0",
    "next": "15.5.28",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.18.0",
    "@types/papaparse": "^5.3.16",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^8.0.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
