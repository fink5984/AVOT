// AVOT Studio — data model.
// All business tables carry organizationId so a future multi-tenant (SaaS) mode
// only needs routing/billing, not a schema rewrite. Every query in the app layer
// is scoped by the caller's organization (see src/server/auth/principal.ts).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  PHOTOGRAPHER
  VIEWER
  /// warehouse / handheld scanner staff
  WAREHOUSE
}

/// Physical copy's place in the warehouse flow (independent of photo and sale status).
enum PhysicalStatus {
  AWAITING_STORAGE
  IN_STORAGE
  AWAITING_PICK
  PICKED
  PACKED
  SHIPPED
  MISSING
}

/// Commercial state. On InventoryItem it summarises the book; on Lot it is that catalog's outcome.
enum CommercialStatus {
  UNASSIGNED
  ASSIGNED
  OFFERED
  SOLD
  UNSOLD
  WITHDRAWN
}

enum BookSize {
  UNKNOWN
  SMALL
  MEDIUM
  LARGE
  OVERSIZE
}

enum LotAssignmentStatus {
  ACTIVE
  ENDED
}

enum StatusDimension {
  PHOTO
  PHYSICAL
  COMMERCIAL
  /// "מצב פרטי הפריט": human review of the item's details (see ItemReviewStatus)
  REVIEW
}

/// What the physical item is. UNKNOWN until a person or the AI analysis decides; a book is the common case.
enum ItemType {
  UNKNOWN
  BOOK
  MANUSCRIPT
  LETTER
  DOCUMENT
  POSTER
  PERIODICAL
  PHOTOGRAPH
  MAP
  JUDAICA
  ARTWORK
  EPHEMERA
  OTHER
}

/// "מצב פרטי הפריט": human review of the details, separate from photo / physical / commercial status and from the AI run.
enum ItemReviewStatus {
  NOT_STARTED
  PENDING_REVIEW
  IN_REVIEW
  APPROVED
}

/// State of the item's AI analysis (the latest run). Also the state of one InventoryAnalysis run.
enum AiAnalysisStatus {
  NOT_RUN
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum DescriptionSource {
  MANUAL
  AI
  IMPORT
}

enum MovementKind {
  STORE
  TRANSFER
  PICK
  RETURN
  COUNT_ADJUST
  MANUAL
}

enum ScanMode {
  STORE
  TRANSFER
  FIND
  PICK
  COUNT
}

enum ScanResult {
  OK
  NOOP
  ERROR
  CONFLICT
}

enum StockCountStatus {
  OPEN
  REVIEW
  APPROVED
  CANCELLED
}

enum PickStatus {
  OPEN
  PICKED
  PACKED
  SHIPPED
  CANCELLED
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum CatalogStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum LotStatus {
  NOT_STARTED
  IN_PROGRESS
  PENDING_REVIEW
  COMPLETED
  NEEDS_RESHOOT
}

enum PhotoCategory {
  COVER
  TITLE_PAGE
  INTERIOR
  EXTERIOR
}

enum CaptureSource {
  WEBCAM
  CANON_EDSDK
  DIGICAMCONTROL
  SIMULATOR
  IMPORT
}

enum FileRole {
  PRIMARY // displayable original (JPEG/PNG/…); used for previews
  RAW // camera RAW (CR3 …) captured in the same shutter action
}

enum UploadStatus {
  PENDING
  UPLOADING
  VERIFIED
  FAILED
}

enum ProcessingStatus {
  PENDING
  DONE
  UNSUPPORTED
  FAILED
}

/// Green-screen processing (rotation, background removal, crop) of a photo's PRIMARY original.
enum ImageProcessingState {
  /// not requested (older shots, processing disabled)
  NONE
  QUEUED
  /// fast preview exists, full-resolution pass pending
  PREVIEW_READY
  DONE
  /// detection was not trusted — only rotated, a person should check
  NEEDS_REVIEW
  FAILED
}

enum CaptureSessionStatus {
  ACTIVE
  ENDED
  ABANDONED
}

enum JobType {
  EXPORT_ZIP
  PROCESS_ASSET
  PROCESS_FINAL
  PURGE_TRASH
  /// permanent deletion of books + their files (see services/deletion.ts)
  DELETE_ITEMS
  /// permanent deletion of catalogs (books stay in inventory)
  DELETE_CATALOGS
  /// AI analysis of one item's photos and details (see services/ai-analysis.ts)
  AI_ANALYZE
  /// "הוספת מידע ותיקון ממוקד ב-AI": a targeted rewrite of the catalog text, applied on the server (see services/ai-analysis.ts)
  AI_REWRITE
}

enum PrintJobKind {
  BOOK
  LOCATION
  TEST
}

/// PENDING → CLAIMED (a print agent took it) → SENT (written to the printer) → DONE (printer confirmed).
/// Printers that cannot report completion stay at SENT: the UI never claims "printed" for them.
enum PrintJobStatus {
  PENDING
  CLAIMED
  SENT
  DONE
  FAILED
  CANCELLED
}

enum PrinterConnection {
  /// raw TCP (port 9100) from the print agent on the local network
  NETWORK
  /// a Windows printer (USB or shared) addressed by its Windows name
  WINDOWS
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Organization {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  slug               String   @unique
  /// days a soft-deleted photo stays restorable before purge
  trashRetentionDays Int      @default(30)
  /// last allocated InventoryItem.serial (allocated with UPDATE … RETURNING, never reused)
  inventorySerialSeq BigInt   @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users          User[]
  auctionHouses  AuctionHouse[]
  inventoryItems InventoryItem[]
  numberAliases  InventoryNumberAlias[]
  warehouses     Warehouse[]
  catalogs       Catalog[]
  lots           Lot[]
  assets         PhotoAsset[]
  devices        Device[]
  auditLogs      AuditLog[]
  jobs           Job[]
  invites        Invite[]
  pairingCodes   PairingCode[]
  captureSession CaptureSession[]
  cameraProfiles CameraProfile[]
  printers       Printer[]
  printJobs      PrintJob[]
  labelTemplates LabelTemplate[]
  consignors     Consignor[]
  deskewBatches  DeskewBatch[]
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  organizationId   String     @db.Uuid
  email            String     @unique
  name             String
  passwordHash     String?
  role             Role       @default(VIEWER)
  status           UserStatus @default(ACTIVE)
  /// permissions granted to this person on top of the role's (only those listed in GRANTABLE_PERMISSIONS, e.g. item.review.approve)
  extraPermissions String[]   @default([])
  lastActiveAt     DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sessions        Session[]
  preferences     UserPreference[]
  createdAssets   PhotoAsset[]         @relation("AssetCreatedBy")
  auditLogs       AuditLog[]
  captureSession  CaptureSession[]
  resetTokens     PasswordResetToken[]
  assignedDevices Device[]             @relation("DeviceAssignedUser")
  /// empty = every auction house; otherwise only these houses' commercial data
  houseAccess     UserHouseAccess[]

  @@index([organizationId])
}

/// An auction house / brand (אבות, טבין). Inventory is shared; catalogs and
/// their lots, descriptions and publishing settings belong to one house.
model AuctionHouse {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  /// stable key used in URLs and the switcher ("avot", "tavin")
  slug           String
  name           String
  nameEn         String?
  /// URL or storage key of the logo; null → wordmark from name
  logoUrl        String?
  primaryColor   String   @default("#1a1917")
  accentColor    String   @default("#cf4416")
  /// publishing defaults, lot-number width, description templates …
  settings       Json     @default("{}")
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  catalogs     Catalog[]
  userAccess   UserHouseAccess[]

  @@unique([organizationId, slug])
}

model UserHouseAccess {
  userId         String @db.Uuid
  auctionHouseId String @db.Uuid

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  auctionHouse AuctionHouse @relation(fields: [auctionHouseId], references: [id], onDelete: Cascade)

  @@id([userId, auctionHouseId])
}

/// One physical copy. Two copies of the same title are two items. The serial /
/// inventory number never changes, whichever house or catalog the book is in.
model InventoryItem {
  id                       String             @id @default(uuid()) @db.Uuid
  organizationId           String             @db.Uuid
  /// sequence number; the public inventory number is 10000000 + serial and is never reused
  serial                   BigInt
  /// "ITM-000184" — brand-neutral, printed on the book's tag
  inventoryNumber          String
  /// Code 128 payload; equals inventoryNumber unless an external tag was registered
  barcode                  String
  title                    String
  subtitle                 String?
  author                   String?
  printPlace               String?
  printYear                String?
  publisher                String?
  /// book, manuscript, poster … (UNKNOWN until decided)
  itemType                 ItemType           @default(UNKNOWN)
  /// edition statement, only when it can be established ("מהדורה שנייה")
  edition                  String?
  /// pagination / extent as verified ("[2], קפ דף")
  extent                   String?
  bibliographicNotes       String?
  internalNotes            String?
  /// physical condition of the copy (binding, foxing …)
  conditionNotes           String?
  /// catalog draft kept on the physical item (AI or manual): the lot heading and long description. A lot of a DRAFT
  /// catalog receives it; a new assignment starts from it. Never published by itself.
  catalogHeadline          String?
  catalogDescription       String?
  catalogDescriptionSource DescriptionSource?
  /// character formatting (bold / underline / color) of bibliographicNotes, conditionNotes and catalogDescription, as text
  /// segments; shown only while the segments spell exactly the stored text (src/lib/rich-text.ts)
  textFormat               Json?
  /// grows on every change of the details (human or AI): optimistic concurrency for autosave and AI results
  detailsVersion           Int                @default(0)
  /// "מצב פרטי הפריט" (human review); transitions are InventoryStatusEvent rows with dimension REVIEW
  reviewStatus             ItemReviewStatus   @default(NOT_STARTED)
  reviewChangedAt          DateTime?
  reviewChangedById        String?            @db.Uuid
  approvedAt               DateTime?
  approvedById             String?            @db.Uuid
  /// the detailsVersion the approver saw and approved (null while not approved)
  approvedVersion          Int?
  /// state of the latest AI analysis run (InventoryAnalysis id in aiRunId); aiCompletedAt = the last successful one
  aiStatus                 AiAnalysisStatus   @default(NOT_RUN)
  aiRunId                  String?            @db.Uuid
  aiCompletedAt            DateTime?
  aiError                  String?
  /// the item's data as it was BEFORE the first AI analysis (fixed once set; only an admin can confirm one): a clean
  /// re-analysis is built from this and the photos, never from the current fields (which may hold AI output)
  originalBaseline         Json?
  originalBaselineAt       DateTime?
  /// who deposited the book for sale. Required for every NEW book (enforced in createItemTx); null only on books that predate consignors
  consignorId              String?            @db.Uuid
  /// the photographer's notes on this physical copy ("missing title page"); separate from internalNotes, never exported
  photographerNotes        String?
  /// client edit counter (ms timestamp): a delayed older save can never overwrite a newer note
  photographerNotesRev     BigInt?
  photographerNotesAt      DateTime?
  photographerNotesById    String?            @db.Uuid
  heightMm                 Int?
  widthMm                  Int?
  depthMm                  Int?
  sizeCategory             BookSize           @default(UNKNOWN)
  /// photography workflow (same values as the legacy Lot.status)
  photoStatus              LotStatus          @default(NOT_STARTED)
  physicalStatus           PhysicalStatus     @default(AWAITING_STORAGE)
  commercialStatus         CommercialStatus   @default(UNASSIGNED)
  /// CategoryRequirements for photography
  requirements             Json
  /// denormalised, maintained transactionally with PhotoAsset writes
  photoCount               Int                @default(0)
  primaryAssetId           String?            @db.Uuid
  currentLocationId        String?            @db.Uuid
  locationUpdatedAt        DateTime?
  /// set when the item was created by the Phase 2 migration from a legacy lot
  migratedFromLotId        String?            @unique @db.Uuid
  /// client-generated key of the "create" request — a double Enter / retried request never creates a second book
  createOpId               String?            @db.Uuid
  /// set when a permanent deletion was requested: the book is hidden from everyday work until its files are gone
  deletionRequestedAt      DateTime?
  deletionRequestedById    String?            @db.Uuid
  receivedAt               DateTime           @default(now())
  photoCompletedAt         DateTime?
  createdById              String?            @db.Uuid
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  organization    Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  currentLocation StorageLocation?            @relation(fields: [currentLocationId], references: [id], onDelete: Restrict)
  consignor       Consignor?                  @relation(fields: [consignorId], references: [id], onDelete: Restrict)
  lots            Lot[]
  assets          PhotoAsset[]
  categoryNotes   InventoryCategoryNote[]
  statusEvents    InventoryStatusEvent[]
  movements       InventoryLocationMovement[]
  analyses        InventoryAnalysis[]
  pickTasks       PickTask[]
  aliases         InventoryNumberAlias[]
  lotMemberships  LotMember[]
  shipmentItems   ShipmentItem[]
  purchases       Purchase[]

  @@unique([organizationId, serial])
  @@unique([organizationId, inventoryNumber])
  @@unique([organizationId, barcode])
  @@unique([organizationId, createOpId])
  @@index([organizationId, updatedAt])
  @@index([organizationId, physicalStatus])
  @@index([organizationId, commercialStatus])
  @@index([organizationId, photoStatus])
  @@index([organizationId, consignorId])
  @@index([organizationId, reviewStatus])
  @@index([currentLocationId])
}

/// A person or company that deposits books for sale. Belongs to the organization (central inventory), never to a
/// catalog or auction house, so the link survives every move of a book. Money (commission, settlement) can later
/// hang off this id without touching identities.
model Consignor {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  phone          String?
  email          String?
  notes          String?
  /// archived consignors keep their books but cannot receive new ones
  archivedAt     DateTime?
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        InventoryItem[]

  @@index([organizationId, name])
  @@index([organizationId, archivedAt])
}

model InventoryCategoryNote {
  inventoryItemId String        @db.Uuid
  category        PhotoCategory
  needsReshoot    Boolean       @default(false)
  notRequired     Boolean       @default(false)
  note            String?
  updatedAt       DateTime      @updatedAt

  item InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@id([inventoryItemId, category])
}

/// Every meaningful status transition, per dimension.
model InventoryStatusEvent {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid
  inventoryItemId String          @db.Uuid
  dimension       StatusDimension
  fromStatus      String?
  toStatus        String
  userId          String?         @db.Uuid
  reason          String?
  /// what caused it: "lot", "pick", "scan", "count" …
  refType         String?
  refId           String?
  createdAt       DateTime        @default(now())

  item InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId, createdAt])
}

/// One AI analysis run of an item (kind "catalog_ai"): what was sent, what came back, what was written, what it cost.
/// At most one QUEUED/RUNNING run per item — partial unique index "InventoryAnalysis_item_active_key" (raw SQL).
model InventoryAnalysis {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @db.Uuid
  inventoryItemId    String           @db.Uuid
  kind               String
  status             AiAnalysisStatus @default(QUEUED)
  provider           String?
  model              String?
  /// item context + image manifest that was sent (no image bytes)
  input              Json?
  /// the validated model answer (null until it succeeded)
  result             Json?
  promptVersion      String?
  examplesVersion    String?
  examplesHash       String?
  examplesCount      Int?
  /// client key of the click that requested the run: a double click never queues two runs
  requestKey         String?          @db.Uuid
  jobId              String?          @db.Uuid
  /// a run over an item that already had a successful analysis (needs a manager's approval)
  isReanalysis       Boolean          @default(false)
  approvedById       String?          @db.Uuid
  imageCount         Int              @default(0)
  requestCount       Int              @default(0)
  inputTokens        Int?
  cachedInputTokens  Int?
  outputTokens       Int?
  /// thinking tokens (OpenAI: included in outputTokens; Gemini: billed in addition)
  reasoningTokens    Int?
  costUsd            Decimal?         @db.Decimal(12, 6)
  /// true when the cost is not computed from provider-reported usage with a known price
  costEstimated      Boolean          @default(true)
  /// provider calls, per-call usage, image preparation report, warnings
  usage              Json?
  durationMs         Int?
  startedAt          DateTime?
  finishedAt         DateTime?
  error              String?
  /// AI-writable values when the run started (to detect human edits made during the run)
  baseValues         Json?
  /// every AI-writable value just before the result was written (restore point)
  snapshot           Json?
  /// fields actually written, kept, or flagged, with the values written
  applied            Json?
  /// filled when a person approves the item: which AI values they changed (provider comparison)
  reviewOutcome      Json?
  restoredAt         DateTime?
  restoredById       String?          @db.Uuid
  /// AiSettingsVersion.version the run was started with (null = the built-in defaults)
  settingsVersion    Int?
  /// external research of the run: queries, the sources found (url, kind, relevance, what was learned), limits, cost
  research           Json?
  /// the item's detailsVersion when the run was requested (a rewrite is applied only if it is still current)
  baseDetailsVersion Int?
  createdById        String?          @db.Uuid
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt

  item InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([organizationId, requestKey])
  @@index([inventoryItemId, createdAt])
  @@index([organizationId, createdAt])
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  /// sha256 of the cookie token — the raw token is never stored
  tokenHash  String   @unique
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Invite {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  email          String
  name           String
  role           Role
  tokenHash      String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreference {
  userId    String   @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

model Catalog {
  id                  String        @id @default(uuid()) @db.Uuid
  organizationId      String        @db.Uuid
  auctionHouseId      String        @db.Uuid
  /// human catalog number, e.g. "3" or "2026-A"; unique per auction house
  number              String
  name                String
  description         String?
  saleDate            DateTime?     @db.Date
  status              CatalogStatus @default(DRAFT)
  coverAssetId        String?       @db.Uuid
  /// default CategoryRequirements applied to new lots
  defaultRequirements Json
  archivedAt          DateTime?
  /// id of the sale in an external system (Bidspirit), when known
  externalRef         String?
  /// "סיום מכירה": the auction itself is over. Independent of archiving and of payments / shipments, which go on
  saleFinishedAt      DateTime?
  saleFinishedById    String?       @db.Uuid
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  auctionHouse AuctionHouse       @relation(fields: [auctionHouseId], references: [id], onDelete: Restrict)
  lots         Lot[]
  assets       PhotoAsset[]
  orders       BuyerOrder[]
  purchases    Purchase[]
  saleImports  SaleResultImport[]

  @@unique([auctionHouseId, number])
  @@index([organizationId, status])
}

/// A catalog lot: one physical book's participation in one catalog (the
/// "CatalogLot"). The table keeps its historical name so existing ids, links
/// and printed labels stay valid. Bibliographic fields here are the catalog's
/// presentation copy, initialised from the InventoryItem.
/// At most one ACTIVE assignment per item — enforced by the partial unique
/// index "Lot_inventoryItemId_active_key" (raw SQL in the migration).
///
/// COMBINED LOTS: the books of a lot are the LotMember rows (source of truth: one row for an ordinary lot, two or
/// more for a combined lot). Lot.inventoryItemId is only the "anchor" kept for older code and for the unique index:
/// always a present member (the first one); it never means "the book of this lot" when the lot has several.
model Lot {
  id                     String              @id @default(uuid()) @db.Uuid
  organizationId         String              @db.Uuid
  catalogId              String              @db.Uuid
  inventoryItemId        String              @db.Uuid
  lotNumber              Int
  sortOrder              Int
  title                  String
  subtitle               String?
  shortDescription       String?
  /// long catalog description (versioned in LotDescriptionVersion)
  description            String?
  /// character formatting (bold / underline / color) of shortDescription and description, as text segments; shown only
  /// while the segments spell exactly the stored text (see src/lib/rich-text.ts) - the plain columns stay the source of truth
  textFormat             Json?
  internalNotes          String?
  author                 String?
  printYear              String?
  printPlace             String?
  /// mirror of InventoryItem.photoStatus, kept in the same transaction
  status                 LotStatus           @default(NOT_STARTED)
  /// legacy per-lot requirements; photography requirements now live on the item
  requirements           Json
  /// mirror of the item's photo count
  photoCount             Int                 @default(0)
  /// catalog-specific primary photo (null → the item's primary photo)
  primaryAssetId         String?             @db.Uuid
  completedAt            DateTime?
  assignmentStatus       LotAssignmentStatus @default(ACTIVE)
  commercialStatus       CommercialStatus    @default(ASSIGNED)
  assignedAt             DateTime            @default(now())
  assignedById           String?             @db.Uuid
  endedAt                DateTime?
  endReason              String?
  /// reference to a designed catalog page (future layout module)
  pageRef                Json?
  /// Starting price in USD. The price belongs to the LOT (a book only in stock has none). null = not set — never 0.
  startingPrice          Decimal?            @db.Decimal(12, 2)
  /// grows on every change of the starting price: two people editing the same price are detected (optimistic concurrency)
  priceVersion           Int                 @default(0)
  /// what happens to the lot after an auction in which it did not sell
  unsoldDisposition      UnsoldDisposition   @default(NONE)
  /// id of the lot in an external system (Bidspirit), when known
  externalRef            String?
  /// set on a lot that was merged into another lot: it stays as ENDED history, is never shown as a separate lot and
  /// its number is never reused; cleared when its book leaves the combined lot and the lot is reactivated
  mergedIntoLotId        String?             @db.Uuid
  /// grows on every change of the lot's books (merge, add, remove): an AI description written for an older composition is stale
  compositionVersion     Int                 @default(1)
  /// the lot holds an applied AI description that was written for a previous composition
  descriptionNeedsUpdate Boolean             @default(false)
  /// the LotAiRun whose text is the lot's current description (null = written by hand)
  aiDescriptionRunId     String?             @db.Uuid
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  catalog             Catalog                 @relation(fields: [catalogId], references: [id], onDelete: Restrict)
  item                InventoryItem           @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  mergedInto          Lot?                    @relation("LotMerge", fields: [mergedIntoLotId], references: [id], onDelete: SetNull)
  mergedFrom          Lot[]                   @relation("LotMerge")
  assets              PhotoAsset[]
  categoryNotes       LotCategoryNote[]
  displayAssets       LotDisplayAsset[]
  descriptionVersions LotDescriptionVersion[]
  pickTasks           PickTask[]
  members             LotMember[]
  aiRuns              LotAiRun[]
  compositionEvents   LotCompositionEvent[]
  priceEvents         LotPriceEvent[]
  purchases           Purchase[]

  @@unique([catalogId, lotNumber])
  @@index([organizationId])
  @@index([catalogId, sortOrder])
  @@index([catalogId, status])
  @@index([inventoryItemId])
  @@index([mergedIntoLotId])
}

/// The books of a catalog lot. An ordinary lot has one present member, a combined lot two or more. Books stay
/// independent inventory items (never copied, merged or re-owned); this table only says which books are sold together.
/// Rows are never deleted when a book leaves or the lot is merged away / dissolved: removedAt closes them, so the
/// history of every membership stays. Two partial unique indexes (raw SQL in the migration):
///  - "LotMember_item_active_key": a book is present in at most one ACTIVE lot (isActive = present AND the lot is ACTIVE);
///  - "LotMember_lot_item_present_key": a book is present at most once in one lot.
model LotMember {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  lotId           String    @db.Uuid
  inventoryItemId String    @db.Uuid
  /// order of the books inside the lot (1-based)
  sortOrder       Int
  /// the lot this book was the only book of before it joined a combined lot (reactivated when it leaves)
  originLotId     String?   @db.Uuid
  /// present in the lot (removedAt is null) AND the lot is ACTIVE: maintained together with Lot.assignmentStatus
  isActive        Boolean   @default(true)
  addedAt         DateTime  @default(now())
  addedById       String?   @db.Uuid
  removedAt       DateTime?
  removedById     String?   @db.Uuid
  /// MERGED | REMOVED | DISSOLVED | free text
  removalReason   String?

  lot  Lot           @relation(fields: [lotId], references: [id], onDelete: Cascade)
  item InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([lotId, removedAt])
  @@index([inventoryItemId, isActive])
  @@index([organizationId])
}

/// Immutable history of a lot's composition: every merge, addition, removal and dissolution (who, when, which books,
/// and the presentation the lot had before), so nothing about a combination is ever lost.
model LotCompositionEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  lotId          String   @db.Uuid
  /// MERGE | ADD | REMOVE | DISSOLVE | REORDER
  kind           String
  itemIds        Json
  userId         String?  @db.Uuid
  data           Json?
  createdAt      DateTime @default(now())

  lot Lot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([lotId, createdAt])
}

/// A shared AI description run for a lot: its own history, never touching the books' own analyses. The result reaches
/// the lot's description fields only when a person applies it (as a LotDescriptionVersion).
model LotAiRun {
  id                       String           @id @default(uuid()) @db.Uuid
  organizationId           String           @db.Uuid
  lotId                    String           @db.Uuid
  status                   AiAnalysisStatus @default(RUNNING)
  /// Lot.compositionVersion when the run started
  compositionVersion       Int
  /// the books that were in the lot: [{itemId, inventoryNumber, sortOrder, detailsVersion, reviewStatus}]
  members                  Json
  /// the structured input that was sent: one block per book with its own id and a verified flag
  input                    Json?
  provider                 String?
  model                    String?
  /// AiSettingsVersion.version used (null = built-in defaults)
  settingsVersion          Int?
  promptVersion            String?
  examplesVersion          String?
  examplesHash             String?
  proposedTitle            String?
  proposedShortDescription String?
  proposedDescription      String?
  /// the validated model answer
  result                   Json?
  requestCount             Int              @default(0)
  inputTokens              Int?
  cachedInputTokens        Int?
  outputTokens             Int?
  costUsd                  Decimal?         @db.Decimal(12, 6)
  costEstimated            Boolean          @default(true)
  usage                    Json?
  durationMs               Int?
  error                    String?
  createdById              String?          @db.Uuid
  createdAt                DateTime         @default(now())
  finishedAt               DateTime?
  /// applied to the lot by a person after the preview: appliedVersion = the LotDescriptionVersion it became
  appliedAt                DateTime?
  appliedById              String?          @db.Uuid
  appliedVersion           Int?
  discardedAt              DateTime?

  lot Lot? @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@index([lotId, createdAt])
  @@index([organizationId, createdAt])
}

/// Per-catalog presentation of an item's photos (order / hidden) without copying files.
model LotDisplayAsset {
  lotId     String  @db.Uuid
  assetId   String  @db.Uuid
  sortOrder Int?
  hidden    Boolean @default(false)

  lot   Lot        @relation(fields: [lotId], references: [id], onDelete: Cascade)
  asset PhotoAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([lotId, assetId])
}

model LotDescriptionVersion {
  id               String            @id @default(uuid()) @db.Uuid
  lotId            String            @db.Uuid
  version          Int
  title            String?
  shortDescription String?
  description      String?
  source           DescriptionSource @default(MANUAL)
  createdById      String?           @db.Uuid
  createdAt        DateTime          @default(now())

  lot Lot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@unique([lotId, version])
}

/// Legacy per-lot category flags (kept read-only after the migration; see InventoryCategoryNote)
model LotCategoryNote {
  lotId        String        @db.Uuid
  category     PhotoCategory
  needsReshoot Boolean       @default(false)
  notRequired  Boolean       @default(false)
  note         String?
  updatedAt    DateTime      @updatedAt

  lot Lot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@id([lotId, category])
}

/// One shot (one shutter action). RAW+JPEG from the same shot are two PhotoFile
/// rows under the same asset — the shot group.
model PhotoAsset {
  id               String               @id @default(uuid()) @db.Uuid
  organizationId   String               @db.Uuid
  /// owner: source photos belong to the physical copy
  inventoryItemId  String               @db.Uuid
  /// provenance only — the catalog / lot the shot was taken for (null when shot from inventory)
  catalogId        String?              @db.Uuid
  lotId            String?              @db.Uuid
  category         PhotoCategory
  /// client-generated id of the capture request — the idempotency key
  captureId        String               @db.Uuid
  captureSessionId String?              @db.Uuid
  source           CaptureSource
  cameraName       String?
  /// per-item running number shown in the filmstrip (never reused)
  sequence         Int
  /// master order within the item + category
  sortOrder        Int
  /// the item's primary photo
  isPrimary        Boolean              @default(false)
  displayName      String?
  notes            String?
  /// non-destructive view transforms
  rotation         Int                  @default(0)
  crop             Json?
  width            Int?
  height           Int?
  exif             Json?
  capturedAt       DateTime
  /// thumbnail / preview derivatives (never the original)
  thumbKey         String?
  previewKey       String?
  processingStatus ProcessingStatus     @default(PENDING)
  /// green-screen processing: state, the settings snapshot taken at capture time (+ manual edits) and the outcome
  imageState       ImageProcessingState @default(NONE)
  processing       Json?
  processingResult Json?
  /// full-resolution processed image (rotated, background removed, cropped); the original stays untouched
  processedKey     String?
  processedMime    String?
  processedWidth   Int?
  processedHeight  Int?
  /// automatic quality hints — advisory only, never used to delete or approve
  quality          Json?
  needsReshoot     Boolean              @default(false)
  reshootNote      String?
  createdById      String?              @db.Uuid
  deletedAt        DateTime?
  deletedById      String?              @db.Uuid
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  item           InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  catalog        Catalog?          @relation(fields: [catalogId], references: [id], onDelete: SetNull)
  lot            Lot?              @relation(fields: [lotId], references: [id], onDelete: SetNull)
  createdBy      User?             @relation("AssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  captureSession CaptureSession?   @relation(fields: [captureSessionId], references: [id], onDelete: SetNull)
  files          PhotoFile[]
  lotDisplay     LotDisplayAsset[]

  @@unique([organizationId, captureId])
  @@index([inventoryItemId, category, deletedAt, sortOrder])
  @@index([lotId, category, deletedAt, sortOrder])
  @@index([catalogId])
  @@index([organizationId, deletedAt])
}

model PhotoFile {
  id               String       @id @default(uuid()) @db.Uuid
  assetId          String       @db.Uuid
  role             FileRole
  originalFilename String
  mimeType         String
  extension        String
  /// size and sha256 declared by the uploader; verified against the stored bytes
  sizeBytes        BigInt
  sha256           String
  storageKey       String       @unique
  uploadStatus     UploadStatus @default(PENDING)
  uploadAttempts   Int          @default(0)
  lastError        String?
  verifiedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  asset PhotoAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, role])
  @@index([sha256])
  @@index([uploadStatus])
}

model CaptureSession {
  id              String               @id @default(uuid()) @db.Uuid
  organizationId  String               @db.Uuid
  userId          String               @db.Uuid
  deviceId        String?              @db.Uuid
  cameraKind      String
  cameraName      String?
  inventoryItemId String?              @db.Uuid
  catalogId       String?              @db.Uuid
  lotId           String?              @db.Uuid
  activeCategory  PhotoCategory
  status          CaptureSessionStatus @default(ACTIVE)
  shotCount       Int                  @default(0)
  startedAt       DateTime             @default(now())
  lastActivityAt  DateTime             @default(now())
  endedAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  device       Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  assets       PhotoAsset[]

  @@index([organizationId, startedAt])
  @@index([userId, status])
}

/// A named capture profile: camera control values + green-screen processing settings.
/// At most one default per organization (partial unique index in the migration).
model CameraProfile {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  isDefault      Boolean  @default(false)
  /// { processing: ProcessingSettings, camera: { [controlId]: value } }
  settings       Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// A paired capture station (Windows Capture Agent).
model Device {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @db.Uuid
  name              String
  /// CAPTURE (camera station) | PRINT (label print agent)
  kind              String    @default("CAPTURE")
  machineName       String?
  /// sha256 of the bearer token used by the agent for server calls
  tokenHash         String    @unique
  /// AES-GCM encrypted HMAC secret shared with the agent (signs browser control tokens)
  secretEnc         String
  assignedUserId    String?   @db.Uuid
  agentVersion      String?
  apiVersion        Int?
  cameraKind        String?
  cameraModel       String?
  cameraConnected   Boolean   @default(false)
  /// print agents: JSON status of the printers it drives, and the agent's own report
  printStatus       Json?
  storagePath       String?
  freeDiskBytes     BigInt?
  pendingUploads    Int       @default(0)
  failedUploads     Int       @default(0)
  lastSyncAt        DateTime?
  lastError         String?
  controllingUserId String?   @db.Uuid
  lastSeenAt        DateTime?
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedUser User?            @relation("DeviceAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  sessions     CaptureSession[]

  @@index([organizationId])
}

model PairingCode {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  codeHash       String    @unique
  deviceName     String
  kind           String    @default("CAPTURE")
  createdById    String    @db.Uuid
  expiresAt      DateTime
  usedAt         DateTime?
  deviceId       String?   @db.Uuid
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Durable background jobs (exports, derivative processing, trash purge).
/// Claimed with FOR UPDATE SKIP LOCKED, so several app instances are safe.
model Job {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  type           JobType
  status         JobStatus @default(QUEUED)
  payload        Json
  progress       Int       @default(0)
  progressTotal  Int       @default(0)
  resultKey      String?
  resultName     String?
  resultBytes    BigInt?
  error          String?
  attempts       Int       @default(0)
  runAfter       DateTime  @default(now())
  lockedAt       DateTime?
  createdById    String?   @db.Uuid
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  finishedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, runAfter])
  @@index([organizationId, type, createdAt])
}

model AuditLog {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  userId          String?  @db.Uuid
  deviceId        String?  @db.Uuid
  action          String
  entityType      String
  entityId        String?
  /// lot id for quick "history of this lot" queries
  lotId           String?  @db.Uuid
  /// inventory item — "history of this book" across catalogs and houses
  inventoryItemId String?  @db.Uuid
  data            Json?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([lotId, createdAt])
  @@index([inventoryItemId, createdAt])
  @@index([entityType, entityId])
}

/**
 * ─────────────────────────── Warehouse ───────────────────────────
 */

model Warehouse {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String
  name           String
  isDefault      Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  zones         WarehouseZone[]
  countSessions StockCountSession[]

  @@unique([organizationId, code])
}

model WarehouseZone {
  id          String    @id @default(uuid()) @db.Uuid
  warehouseId String    @db.Uuid
  code        String
  name        String
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  /// taken out of the active structure (it has history, so the row stays; its code is never reused)
  deletedAt   DateTime?

  warehouse     Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  shelves       Shelf[]
  countSessions StockCountSession[]

  @@unique([warehouseId, code])
}

model Shelf {
  id        String    @id @default(uuid()) @db.Uuid
  zoneId    String    @db.Uuid
  /// the identity of the shelf: part of the printed barcode (LOC-W1-C4-04). Never edited.
  code      String
  /// display name only ("מדף עליון - הלכה"); null = the default "מדף {code}". Unique per column among live shelves (partial index, see the migration).
  name      String?
  /// e.g. open shelf, closed cabinet, flat-file drawer, safe
  shelfType String?
  notes     String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  /// taken out of the active structure (it has history, so the row stays; its code is never reused)
  deletedAt DateTime?

  zone      WarehouseZone     @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  locations StorageLocation[]

  @@unique([zoneId, code])
}

/// The place a book is assigned to: exactly one active location per shelf (warehouse → column → shelf). Code like
/// LOC-W1-C4-04. Older rows may be "merged" into the shelf's location (mergedIntoId) — they only keep history valid.
model StorageLocation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  shelfId        String    @db.Uuid
  /// legacy: the old cell level. New locations always get "01"; nothing reads it for work any more.
  cell           String
  /// unique human code, also the printed barcode
  code           String
  /// suitable book size
  sizeClass      BookSize?
  capacity       Int?
  isFull         Boolean   @default(false)
  notes          String?
  active         Boolean   @default(true)
  /// zone/shelf order used to sort pick routes
  sortKey        String
  /// set when this was a cell of a shelf that was merged into one location: history keeps pointing here
  mergedIntoId   String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  shelf      Shelf                       @relation(fields: [shelfId], references: [id], onDelete: Restrict)
  aliases    StorageLocationAlias[]
  mergedInto StorageLocation?            @relation("LocationMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom StorageLocation[]           @relation("LocationMerge")
  items      InventoryItem[]
  movesFrom  InventoryLocationMovement[] @relation("MoveFrom")
  movesTo    InventoryLocationMovement[] @relation("MoveTo")

  @@unique([organizationId, code])
  @@index([organizationId, sortKey])
}

/// Former barcodes of a shelf (printed "LOC-W1-C4-04-01"): scanning one still finds the shelf. Codes of deleted shelves are kept
/// here too (locationId null), so no code is ever reused.
model StorageLocationAlias {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  /// null = the shelf was deleted; the code stays reserved and is never given to another shelf
  locationId     String?  @db.Uuid
  alias          String
  createdAt      DateTime @default(now())

  location StorageLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([organizationId, alias])
  @@index([locationId])
}

/// The calibration of one kind of label (book / shelf / column) for the whole organization: the single design every
/// print path uses. Only the values that differ from the built-in defaults are meaningful; see label-layout.ts.
model LabelTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  /// BOOK | LOCATION | ZONE
  type           String
  profile        Json
  updatedById    String?  @db.Uuid
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, type])
}

model InventoryLocationMovement {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  inventoryItemId String       @db.Uuid
  fromLocationId  String?      @db.Uuid
  toLocationId    String?      @db.Uuid
  kind            MovementKind
  userId          String?      @db.Uuid
  /// idempotency key of the scan / request that caused it
  opId            String?      @db.Uuid
  /// when it physically happened (scanner clock; may precede createdAt when synced late)
  occurredAt      DateTime     @default(now())
  note            String?
  createdAt       DateTime     @default(now())

  item InventoryItem    @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  from StorageLocation? @relation("MoveFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)
  to   StorageLocation? @relation("MoveTo", fields: [toLocationId], references: [id], onDelete: SetNull)

  @@unique([organizationId, opId])
  @@index([inventoryItemId, occurredAt])
}

/// Every scan received from a scanner client, with its server outcome.
/// opId is generated on the device per scan: re-sending is idempotent.
model BarcodeScanEvent {
  id                String     @id @default(uuid()) @db.Uuid
  organizationId    String     @db.Uuid
  opId              String     @db.Uuid
  userId            String?    @db.Uuid
  mode              ScanMode
  code              String
  /// ITEM | LOCATION | COMMAND | UNKNOWN
  codeType          String
  inventoryItemId   String?    @db.Uuid
  locationId        String?    @db.Uuid
  /// active location the client had when the scan happened
  contextLocationId String?    @db.Uuid
  result            ScanResult
  message           String?
  clientAt          DateTime
  receivedAt        DateTime   @default(now())
  /// arrived from the offline queue
  deferred          Boolean    @default(false)
  deviceLabel       String?
  /// CONFLICT rows: how a manager resolved them
  resolvedAt        DateTime?
  resolvedById      String?    @db.Uuid
  resolution        String?

  @@unique([organizationId, opId])
  @@index([organizationId, receivedAt])
  @@index([organizationId, result, resolvedAt])
  @@index([inventoryItemId])
}

model StockCountSession {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  warehouseId    String           @db.Uuid
  zoneId         String?          @db.Uuid
  status         StockCountStatus @default(OPEN)
  note           String?
  startedById    String?          @db.Uuid
  startedAt      DateTime         @default(now())
  submittedAt    DateTime?
  approvedById   String?          @db.Uuid
  approvedAt     DateTime?
  /// discrepancy report frozen at approval, and which corrections were applied
  result         Json?

  warehouse Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  zone      WarehouseZone?       @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  locations StockCountLocation[]
  entries   StockCountEntry[]

  @@index([organizationId, status])
}

/// A location the counter visited (scanned) during the session.
model StockCountLocation {
  sessionId  String   @db.Uuid
  locationId String   @db.Uuid
  visitedAt  DateTime @default(now())
  userId     String?  @db.Uuid

  session StockCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, locationId])
}

model StockCountEntry {
  id                 String   @id @default(uuid()) @db.Uuid
  sessionId          String   @db.Uuid
  locationId         String   @db.Uuid
  inventoryItemId    String   @db.Uuid
  /// where the database said the item was at scan time
  expectedLocationId String?  @db.Uuid
  scannedById        String?  @db.Uuid
  scannedAt          DateTime @default(now())

  session StockCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, inventoryItemId])
}

model PickTask {
  id               String     @id @default(uuid()) @db.Uuid
  organizationId   String     @db.Uuid
  inventoryItemId  String     @db.Uuid
  lotId            String?    @db.Uuid
  reason           String
  status           PickStatus @default(OPEN)
  /// the purchase this task fulfils (a sold lot is released to picking explicitly, see Purchase.releasedAt)
  purchaseId       String?    @db.Uuid
  note             String?
  /// location when the task was created (the item may move later)
  sourceLocationId String?    @db.Uuid
  createdById      String?    @db.Uuid
  createdAt        DateTime   @default(now())
  pickedById       String?    @db.Uuid
  pickedAt         DateTime?
  packedById       String?    @db.Uuid
  packedAt         DateTime?
  shippedById      String?    @db.Uuid
  shippedAt        DateTime?
  cancelledAt      DateTime?

  item InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  lot  Lot?          @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([inventoryItemId])
}

/**
 * ─────────────────────────── Label printing ───────────────────────────
 */

/// A label printer. Only the print agent (a paired Device of kind PRINT) talks to it; the server
/// never connects to a printer's local address.
model Printer {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  name           String
  /// free text: "Zebra ZD421", "TSC TE210" …
  model          String?
  connection     PrinterConnection @default(NETWORK)
  /// NETWORK: IPv4/hostname of the printer on the agent's LAN
  host           String?
  port           Int               @default(9100)
  /// WINDOWS: the printer's name in Windows
  windowsName    String?
  /// label stock key (see LABEL_SIZES), e.g. "57x32"
  labelSize      String            @default("57x32")
  /// "ZPL" today; the column keeps room for other languages
  language       String            @default("ZPL")
  /// dots per mm: 8 = 203 dpi, 12 = 300 dpi
  dotsPerMm      Int               @default(8)
  isPrimary      Boolean           @default(false)
  active         Boolean           @default(true)
  /// the print agent that serves this printer (null = any print agent of the organization)
  agentId        String?           @db.Uuid
  lastStatus     String?
  lastStatusAt   DateTime?
  lastError      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobs         PrintJob[]

  @@index([organizationId])
}

model PrintJob {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  printerId       String?        @db.Uuid
  kind            PrintJobKind
  /// [{ "type": "BOOK" | "LOCATION", "id": uuid }]  — rendered by the server when an agent claims the job
  items           Json
  copies          Int            @default(1)
  labelCount      Int            @default(1)
  status          PrintJobStatus @default(PENDING)
  attempts        Int            @default(0)
  /// request key of the click that created the job: a double click never prints twice
  idemKey         String?
  /// labels of the whole click (a big click is split into several jobs), and the number the person confirmed (null: no confirmation was needed)
  batchLabelCount Int?
  confirmedCount  Int?
  /// human summary for the queue ("ITM-000184 · שם הספר")
  summary         String?
  createdById     String?        @db.Uuid
  claimedById     String?        @db.Uuid
  claimedAt       DateTime?
  sentAt          DateTime?
  doneAt          DateTime?
  error           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  printer      Printer?     @relation(fields: [printerId], references: [id], onDelete: SetNull)

  @@unique([organizationId, idemKey])
  @@index([organizationId, status, createdAt])
  @@index([status, createdAt])
}

/// Former inventory numbers ("ITM-000035"). Printed tags keep working: scanning or searching an alias finds the same book.
model InventoryNumberAlias {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  inventoryItemId String   @db.Uuid
  alias           String
  /// LEGACY_ITM = the number printed before the numeric scheme
  kind            String   @default("LEGACY_ITM")
  createdAt       DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([organizationId, alias])
  @@index([inventoryItemId])
}

/// Straightening (auto deskew) of photos that already exist: one batch = one run of scripts/deskew-batch.ts.
/// Every changed photo keeps a snapshot of its previous processed version, so the whole batch can be rolled back.
enum DeskewBatchStatus {
  RUNNING
  PAUSED
  COMPLETED
  ROLLED_BACK
}

enum DeskewItemStatus {
  PENDING
  /// claimed by a worker; after a crash such items are put back to PENDING
  PROCESSING
  /// a new processed version was written and the photo points at it
  APPLIED
  /// examined, nothing changed (reason in skipReason)
  SKIPPED
  FAILED
  ROLLED_BACK
}

model DeskewBatch {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  status         DeskewBatchStatus @default(RUNNING)
  /// version of the deskew algorithm the batch was planned with
  algoVersion    Int
  /// limits, flags and who started it
  params         Json
  createdAt      DateTime          @default(now())
  finishedAt     DateTime?
  rolledBackAt   DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        DeskewBatchItem[]

  @@index([organizationId, createdAt])
}

model DeskewBatchItem {
  id          String           @id @default(uuid()) @db.Uuid
  batchId     String           @db.Uuid
  /// no foreign key on purpose: purging a photo must never be blocked by its straightening history
  assetId     String           @db.Uuid
  status      DeskewItemStatus @default(PENDING)
  attempts    Int              @default(0)
  kind        String?
  tilt        Float?
  angle       Float?
  confidence  Float?
  skipReason  String?
  /// true when a new processed file was written
  changed     Boolean          @default(false)
  ms          Int?
  error       String?
  /// the photo's processed version before this item changed it (keys, size, state, result) — what a rollback restores
  previous    Json?
  /// keys of the files this item wrote (never overwrite an existing key)
  newKeys     Json?
  processedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  batch DeskewBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, assetId])
  @@index([batchId, status])
  @@index([assetId])
}

/// The organization's AI configuration (the "הגדרות AI" tab). One current row; every save also writes an immutable
/// AiSettingsVersion, and a run keeps the version it started with. Null prompt / examples = the built-in default.
model AiSettings {
  organizationId         String   @id @db.Uuid
  /// current version number (AiSettingsVersion.version)
  version                Int      @default(0)
  provider               String?
  model                  String?
  /// OpenAI reasoning effort / Gemini thinking level (null = the model's default)
  reasoning              String?
  analysisPrompt         String?
  manuscriptPrompt       String?
  rewritePrompt          String?
  fullRewritePrompt      String?
  /// style examples (same JSON as catalog-style-examples.json); null = the file in the code
  examples               Json?
  /// external research (web search) of the analysis; null = the built-in defaults (on, 6 sources, 150 s, 4 searches)
  researchEnabled        Boolean?
  researchMaxSources     Int?
  researchTimeoutSeconds Int?
  researchMaxSearches    Int?
  /// stop researching once the research of one analysis cost this much (USD); null = no cap beyond the searches limit
  researchMaxCostUsd     Decimal? @db.Decimal(8, 4)
  /// auto = the analysis provider's own web search; openai | gemini = that provider's
  researchProvider       String?
  updatedById            String?  @db.Uuid
  updatedAt              DateTime @default(now()) @updatedAt
}

model AiSettingsVersion {
  id                     String   @id @default(uuid()) @db.Uuid
  organizationId         String   @db.Uuid
  version                Int
  provider               String?
  model                  String?
  reasoning              String?
  analysisPrompt         String?
  manuscriptPrompt       String?
  rewritePrompt          String?
  fullRewritePrompt      String?
  examples               Json?
  /// external research (web search) of the analysis; null = the built-in defaults (on, 6 sources, 150 s, 4 searches)
  researchEnabled        Boolean?
  researchMaxSources     Int?
  researchTimeoutSeconds Int?
  researchMaxSearches    Int?
  /// stop researching once the research of one analysis cost this much (USD); null = no cap beyond the searches limit
  researchMaxCostUsd     Decimal? @db.Decimal(8, 4)
  /// auto = the analysis provider's own web search; openai | gemini = that provider's
  researchProvider       String?
  note                   String?
  createdById            String?  @db.Uuid
  createdAt              DateTime @default(now())

  @@unique([organizationId, version])
}

/// What happens to a lot that did not sell at the auction. NONE = not decided (or sold).
enum UnsoldDisposition {
  NONE
  /// still bound to its catalog and available for a sale after the auction
  HOLD_POST_SALE
  /// the assignment ended, the book is back in free stock
  RELEASED_TO_STOCK
  /// the book goes back to its consignor
  RETURN_TO_CONSIGNOR
}

/// Immutable history of a lot's starting price: who set it, who changed it, from what, when. It stays when the lot is
/// sold, the book leaves the catalog, or the lot is merged / dissolved (the lot row itself is never deleted).
model LotPriceEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  /// null only after the lot row itself was deleted (a mistaken assignment): the event stays
  lotId          String?  @db.Uuid
  catalogId      String   @db.Uuid
  lotNumber      Int?
  /// SET | CHANGE | CLEAR | MERGED_INTO | MERGED_FROM | DISSOLVED | ENDED | DELETED
  kind           String
  previous       Decimal? @db.Decimal(12, 2)
  next           Decimal? @db.Decimal(12, 2)
  note           String?
  data           Json?
  userId         String?  @db.Uuid
  createdAt      DateTime @default(now())

  lot Lot? @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@index([lotId, createdAt])
  @@index([organizationId, createdAt])
}

/**
 * ─────────────────────────── Sales, customers, payments, shipments ───────────────────────────
 * Three independent states, never mixed:
 * commercial  Lot.commercialStatus / Purchase.status        (offered, sold, unsold, cancelled …)
 * financial   derived from Purchase + Payment rows          (nothing due yet, unpaid, partial, paid)
 * physical    InventoryItem.physicalStatus + PickTask + Shipment   (in storage, picked, packed, shipped …)
 * Money is DECIMAL(12,2) US dollars; unknown commission / tax stay NULL (never invented, never 0).
 */

enum CustomerStatus {
  ACTIVE
  /// merged into another customer: kept as history, never listed
  MERGED
}

enum PurchaseStatus {
  ACTIVE
  /// the deal was cancelled: kept with the original buyer, price, reason and who cancelled
  CANCELLED
}

enum PurchaseSource {
  IMPORT
  MANUAL
  /// sold after the auction (the lot did not sell at the auction itself)
  POST_SALE
  /// marked by a person: sold in the old system before AVOT (no price, no buyer, no lot)
  LEGACY_MANUAL
}

enum PaymentStatus {
  RECORDED
  VOIDED
}

enum ShipmentStatus {
  /// being prepared; books are reserved, nothing left the warehouse
  DRAFT
  PACKED
  /// physically left (carrier took it / sent)
  SHIPPED
  /// handed over / picked up / delivered
  DELIVERED
  CANCELLED
}

enum ShipmentMethod {
  CARRIER
  PICKUP
  HAND_DELIVERY
}

enum SaleImportStatus {
  PREVIEW
  COMMITTED
  DISCARDED
}

/// A person or company that buys. NOT a consignor (who deposits books): the same person may be both, as two records.
model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  /// internal customer number, 1.. per organization
  number         Int
  name           String
  email          String?
  /// lower-cased / trimmed: the match key
  emailNorm      String?
  phone          String?
  /// digits only, international form when it can be told: the match key
  phoneNorm      String?
  /// [{ label?, name?, line1, line2?, city?, state?, zip?, country? }]
  addresses      Json           @default("[]")
  notes          String?
  /// created from a sale file with too little detail to be sure who it is
  needsDetails   Boolean        @default(false)
  status         CustomerStatus @default(ACTIVE)
  mergedIntoId   String?        @db.Uuid
  createdById    String?        @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  identities CustomerExternalIdentity[]
  orders     BuyerOrder[]
  purchases  Purchase[]
  shipments  Shipment[]

  @@unique([organizationId, number])
  @@index([organizationId, emailNorm])
  @@index([organizationId, phoneNorm])
  @@index([organizationId, name])
}

/// How an external system knows the customer. A permanent buyer id is global within its system; a bidder number belongs
/// to ONE sale (context = the catalog id) and is never a global identifier.
model CustomerExternalIdentity {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  customerId     String   @db.Uuid
  /// "bidspirit" | "file" | …
  system         String
  /// "" for a permanent id; the catalog id for a per-sale bidder number
  context        String   @default("")
  /// BUYER_ID | BIDDER_NUMBER
  kind           String
  externalId     String
  createdAt      DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([organizationId, system, context, kind, externalId])
  @@index([customerId])
}

/// One customer's order in one sale: groups the purchases (and the payments) the customer made in that catalog.
model BuyerOrder {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  catalogId       String   @db.Uuid
  customerId      String   @db.Uuid
  /// order number in an external system, when known
  externalOrderId String?
  createdAt       DateTime @default(now())

  catalog   Catalog    @relation(fields: [catalogId], references: [id], onDelete: Restrict)
  customer  Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  purchases Purchase[]
  payments  Payment[]

  @@unique([catalogId, customerId])
  @@index([customerId])
  @@index([organizationId, catalogId])
}

/// The sale of one lot (a combined lot is ONE purchase of several physical books). At most one ACTIVE purchase per lot
/// (partial unique index in the migration). Cancelled purchases are never deleted.
model Purchase {
  id                    String         @id @default(uuid()) @db.Uuid
  organizationId        String         @db.Uuid
  orderId               String?        @db.Uuid
  customerId            String?        @db.Uuid
  catalogId             String?        @db.Uuid
  /// a legacy sale (before AVOT) has no lot, no catalog and no order: it hangs on the book directly
  inventoryItemId       String?        @db.Uuid
  lotId                 String?        @db.Uuid
  status                PurchaseStatus @default(ACTIVE)
  source                PurchaseSource @default(MANUAL)
  /// the lot did not sell at the auction; this deal came afterwards
  afterAuction          Boolean        @default(false)
  hammerPrice           Decimal?       @db.Decimal(12, 2)
  /// unknown until stated: NULL, never invented
  buyerPremium          Decimal?       @db.Decimal(12, 2)
  tax                   Decimal?       @db.Decimal(12, 2)
  /// the lot's starting price when it sold (the history of the price is kept separately)
  startingPriceAtSale   Decimal?       @db.Decimal(12, 2)
  bidderNumber          String?
  externalTransactionId String?
  /// the file import that created / last confirmed this purchase
  importId              String?        @db.Uuid
  /// fields a person corrected after the import: a re-import never overwrites them
  manualFields          Json           @default("[]")
  /// released to the picking queue (sold ≠ released)
  releasedAt            DateTime?
  releasedById          String?        @db.Uuid
  /// released although not paid, by a person with that permission
  releasedUnpaid        Boolean        @default(false)
  releaseNote           String?
  cancelledAt           DateTime?
  cancelledById         String?        @db.Uuid
  cancelReason          String?
  /// refund state when a paid deal is cancelled (free text: the system does not refund)
  refundNote            String?
  /// the book may go back to free stock after the cancellation (decided by a person)
  returnedToStock       Boolean        @default(false)
  createdById           String?        @db.Uuid
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  order     BuyerOrder?    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer  Customer?      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  catalog   Catalog?       @relation(fields: [catalogId], references: [id], onDelete: Restrict)
  lot       Lot?           @relation(fields: [lotId], references: [id], onDelete: Restrict)
  item      InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  shipItems ShipmentItem[]

  @@unique([organizationId, externalTransactionId])
  @@index([organizationId, status])
  @@index([customerId, status])
  @@index([orderId])
  @@index([catalogId, status])
  @@index([lotId])
  @@index([inventoryItemId])
}

/// Money received (or voided) against an order. Partial payments are normal.
model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  orderId        String        @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  paidAt         DateTime
  method         String?
  reference      String?
  status         PaymentStatus @default(RECORDED)
  /// MANUAL | IMPORT (a later payments import hangs off the same table)
  source         String        @default("MANUAL")
  externalId     String?
  recordedById   String?       @db.Uuid
  voidedAt       DateTime?
  voidedById     String?       @db.Uuid
  voidReason     String?
  createdAt      DateTime      @default(now())

  order BuyerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([organizationId, externalId])
  @@index([orderId, status])
}

/// A delivery to ONE customer: one or several lots, one or several physical books. A book is in at most one ACTIVE
/// shipment (partial unique index on ShipmentItem). SHIPPED means the books really left.
model Shipment {
  id               String         @id @default(uuid()) @db.Uuid
  organizationId   String         @db.Uuid
  /// shipment number, 1.. per organization
  number           Int
  customerId       String         @db.Uuid
  status           ShipmentStatus @default(DRAFT)
  method           ShipmentMethod @default(CARRIER)
  carrier          String?
  trackingNumber   String?
  /// unknown = NULL
  cost             Decimal?       @db.Decimal(12, 2)
  /// name / phone / address as they were when the shipment was made (later edits of the customer do not rewrite it)
  recipient        Json
  notes            String?
  /// the person confirmed sending only part of the customer's waiting books
  partialConfirmed Boolean        @default(false)
  createdById      String?        @db.Uuid
  createdAt        DateTime       @default(now())
  packedAt         DateTime?
  packedById       String?        @db.Uuid
  shippedAt        DateTime?
  shippedById      String?        @db.Uuid
  deliveredAt      DateTime?
  deliveredById    String?        @db.Uuid
  cancelledAt      DateTime?
  cancelledById    String?        @db.Uuid
  cancelReason     String?
  updatedAt        DateTime       @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    ShipmentItem[]

  @@unique([organizationId, number])
  @@index([customerId, status])
  @@index([organizationId, status])
}

/// A physical book inside a shipment. Rows are never deleted: removing or cancelling closes them (isActive = false).
model ShipmentItem {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  shipmentId       String    @db.Uuid
  purchaseId       String    @db.Uuid
  inventoryItemId  String    @db.Uuid
  isActive         Boolean   @default(true)
  addedAt          DateTime  @default(now())
  addedById        String?   @db.Uuid
  removedAt        DateTime?
  removedById      String?   @db.Uuid
  removeReason     String?
  /// the book came back after being shipped / delivered
  returnedAt       DateTime?
  returnedById     String?   @db.Uuid
  returnReason     String?
  returnCondition  String?
  returnLocationId String?   @db.Uuid

  shipment Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  purchase Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  item     InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([shipmentId, isActive])
  @@index([purchaseId])
  @@index([inventoryItemId, isActive])
}

/// Append-only history of every sale-side action (import, sale, correction, payment, release, cancel, shipment steps, merge).
model SaleEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  purchaseId     String?  @db.Uuid
  customerId     String?  @db.Uuid
  shipmentId     String?  @db.Uuid
  catalogId      String?  @db.Uuid
  kind           String
  data           Json?
  userId         String?  @db.Uuid
  createdAt      DateTime @default(now())

  @@index([purchaseId, createdAt])
  @@index([customerId, createdAt])
  @@index([shipmentId, createdAt])
  @@index([catalogId, createdAt])
}

/// An upload of sale results (Excel / CSV today, an API adapter later): the same normalised rows go through the same
/// matching and commit whatever the source was.
model SaleResultImport {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  catalogId        String           @db.Uuid
  /// XLSX | CSV | API
  source           String
  fileName         String
  fileHash         String
  /// optional second file with the buyers' details
  buyersFileName   String?
  buyersFileHash   String?
  /// storage key of the original file(s)
  storageKey       String?
  buyersStorageKey String?
  mapping          Json
  status           SaleImportStatus @default(PREVIEW)
  summary          Json?
  createdById      String?          @db.Uuid
  createdAt        DateTime         @default(now())
  committedAt      DateTime?
  committedById    String?          @db.Uuid

  catalog Catalog               @relation(fields: [catalogId], references: [id], onDelete: Restrict)
  rows    SaleResultImportRow[]

  @@index([catalogId, createdAt])
  @@index([organizationId, fileHash])
}

model SaleResultImportRow {
  id            String   @id @default(uuid()) @db.Uuid
  importId      String   @db.Uuid
  rowIndex      Int
  /// the cells as read
  raw           Json
  /// the normalised row (lot reference, outcome, price, buyer fields)
  normalized    Json
  lotId         String?  @db.Uuid
  /// SOLD | UNSOLD | UNKNOWN
  outcome       String
  hammerPrice   Decimal? @db.Decimal(12, 2)
  customerId    String?  @db.Uuid
  /// EXISTING | NEW | NEEDS_DETAILS | AMBIGUOUS | NONE
  customerMatch String   @default("NONE")
  /// CREATE | UPDATE | UNCHANGED | CONFLICT | SKIP | ERROR
  action        String
  messages      Json     @default("[]")
  purchaseId    String?  @db.Uuid

  import SaleResultImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, rowIndex])
}

/// A saved column mapping for sale-result files, reused for the next file of the same shape.
model SaleImportTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  /// RESULTS | BUYERS
  kind           String
  mapping        Json
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now())

  @@unique([organizationId, kind, name])
}
