# ─── AVOT Studio — environment ────────────────────────────────────────────
# Copy to .env.local for development. In production (Railway) set these as
# service variables. Never commit real values.
#
# ─── Variables to set on the server (Railway → Service → Variables) ───
#   APP_ENV=production            APP_URL=https://<public-domain>
#   DATABASE_URL=<Neon DIRECT endpoint, host without "-pooler">
#   APP_SECRET=<SAME value as the local .env.local — it decrypts paired devices in the DB>
#   STORAGE_DRIVER=s3             S3_ENDPOINT / S3_REGION=auto / S3_BUCKET
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY / S3_FORCE_PATH_STYLE=false
#   ENABLE_SIMULATOR=false        JOB_WORKER_ENABLED=true        LOG_LEVEL=info
# Do NOT set on the server: ADMIN_EMAIL / ADMIN_NAME / ADMIN_PASSWORD (one-off
# create-admin only), STORAGE_LOCAL_DIR, or the .env.local file itself.

# PostgreSQL connection string
#  local cluster (scripts/dev-db.ps1):  postgresql://USER:PASSWORD@127.0.0.1:5433/avot_studio?schema=public
#  Neon: use the DIRECT endpoint (host without "-pooler") — prisma migrate needs a session connection:
#        postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require&schema=public
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5433/avot_studio?schema=public"

# Public base URL of the web app (used for QR labels, agent pairing, origin checks)
APP_URL="http://localhost:3000"

# 32+ random bytes, base64. Signs download links, encrypts device secrets.
# The SAME value must be used by every server that uses the same database —
# otherwise paired capture stations (Device.secretEnc) can no longer be decrypted.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET=""

# development | staging | production
APP_ENV="development"

# ─── Object storage ───
# "local" = files under STORAGE_LOCAL_DIR (development / tests only)
# "s3"    = any S3-compatible store (Cloudflare R2, AWS S3, …) — required in production
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".data/storage"

S3_ENDPOINT=""            # R2: https://<account-id>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ─── Capture ───
# Simulator camera on the capture screen. Always available to admins in
# development; in production only when explicitly enabled (and only to admins).
ENABLE_SIMULATOR="false"

# Background job worker inside the web process (exports, thumbnails, trash purge)
JOB_WORKER_ENABLED="true"

# ─── First admin (used once by `npm run create-admin` if set) ───
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""

# Log level: debug | info | warn | error
LOG_LEVEL="info"
